# Скопируйте в .env или экспортируйте в окружение.
# Основной путь — релей, который отправляет заявки в Telegram.
# Если релей не настроен, используются TELEGRAM_BOT_TOKEN и TELEGRAM_CHAT_ID.

HOST=127.0.0.1
PORT=8000

# Релей (предпочтительно)
RELAY_URL=http://127.0.0.1:8000/lead
RELAY_SECRET=

# Прямая отправка в Telegram (запасной вариант)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
